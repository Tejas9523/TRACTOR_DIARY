<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tractor Expenses"
            android:textColor="#212121"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"
            android:text="Manage and track every rupee spent"
            android:textColor="#757575"
            android:textSize="14sp" />

        <!-- Add Expense Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_light_border">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADD NEW EXPENSE"
                android:textColor="#8A6800"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Expense Date"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/expenseDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#FFF5CC"
                android:text="Select Date"
                android:textAllCaps="false"
                android:textColor="#212121" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Expense Category"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/expenseCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#FFC801"
                android:entries="@array/expense_categories" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Amount (₹)"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/expenseAmount"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#FFC801"
                android:hint="Enter expense amount"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:textColor="#212121"
                android:textColorHint="#999999" />

            <Button
                android:id="@+id/saveExpense"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#FFC801"
                android:text="Save Expense"
                android:textAllCaps="false"
                android:textColor="#212121"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Monthly Expense Chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_light_border">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MONTHLY EXPENSES"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Compare your spending month by month"
                android:textColor="#757575"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Filter by year"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/expenseYearFilter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#FFC801" />

            <TextView
                android:id="@+id/monthlyExpenseYearTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="12dp"
                android:background="#FFF9E5"
                android:text="Total for year: ₹0.00"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Chart is created in Java -->
            <LinearLayout
                android:id="@+id/monthlyExpenseChartContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Recent Expenses -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Recent Expenses"
            android:textColor="#212121"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/expenseHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:text="Your saved expenses will appear here."
            android:textColor="#757575"
            android:textSize="13sp" />

        <!-- Bulk Selection Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_light_border">

            <CheckBox
                android:id="@+id/selectAllExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#FFC801"
                android:text="Select All Expenses"
                android:textColor="#212121"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selectedExpenseCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0 expenses selected"
                android:textColor="#757575"
                android:textSize="13sp" />

            <Button
                android:id="@+id/deleteSelectedExpenses"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FCE8E6"
                android:enabled="false"
                android:text="Delete Selected"
                android:textAllCaps="false"
                android:textColor="#B3261E"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Expense cards generated in Java -->
        <LinearLayout
            android:id="@+id/expenseHistoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

    </LinearLayout>
</ScrollView>
